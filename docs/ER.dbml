Table users {id bigint [pk, increment] name varchar email varchar [unique] password varchar role varchar created_at timestamp updated_at timestamp}
Table categories {id bigint [pk, increment] name varchar slug varchar [unique] description text created_at timestamp updated_at timestamp}
Table components {id bigint [pk, increment] category_id bigint [ref: > categories.id] name varchar brand varchar price decimal stock int power_watts int socket varchar ram_type varchar form_factor varchar wattage int length_mm int max_gpu_length_mm int is_active boolean created_at timestamp updated_at timestamp}
Table configurations {id bigint [pk, increment] user_id bigint [ref: > users.id] name varchar status varchar total_price decimal created_at timestamp updated_at timestamp}
Table configuration_items {id bigint [pk, increment] configuration_id bigint [ref: > configurations.id] component_id bigint [ref: > components.id] quantity int created_at timestamp updated_at timestamp indexes {(configuration_id, component_id) [unique]}}
Table compatibility_rules {id bigint [pk, increment] name varchar description text is_active boolean created_at timestamp updated_at timestamp}
